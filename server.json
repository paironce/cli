{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.paironce/cli",
  "title": "PairOnce",
  "description": "Send files to a phone from an AI agent, or ask it for a photo, scan or file. End-to-end encrypted.",
  "websiteUrl": "https://paironce.com",
  "repository": { "url": "https://github.com/paironce/cli", "source": "github" },
  "version": "0.12.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "paironce",
      "version": "0.12.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
