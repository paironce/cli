  "version": "0.9.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "paironce",
      "version": "0.9.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
